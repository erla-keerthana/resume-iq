# Primary AI: Groq (ultra-fast LPU inference, free tier)
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Fallback AI: OpenRouter (if Groq is unavailable)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# JWT secret for auth tokens (required) — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Comma-separated allowed CORS origins (required)
ALLOWED_ORIGINS=http://localhost:5174

# Optional: Backend port (default: 8001)
# PORT=8001

# Optional: Database URL (default: sqlite:///./resumeiq.db)
# DATABASE_URL=sqlite:///./resumeiq.db
